# Kiro Gateway - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# QUICK START (minimal working config)
# ===========================================

PROXY_API_KEY="my-super-secret-password-123"
KIRO_CREDS_FILE="~/.aws/sso/cache/kiro-auth-token.json"
PROFILE_ARN="arn:aws:codewhisperer:us-east-1:123456789012:profile/XXXXXXXXXXXX"
KIRO_API_REGION=us-east-1
DEBUG_MODE=all

# ===========================================
# HOW TO FIND YOUR PROFILE_ARN
# ===========================================
#
# Your PROFILE_ARN lives inside your Kiro credentials file.
# Run this command to extract it:
#
#   cat ~/.aws/sso/cache/kiro-auth-token.json | python3 -c "import json,sys; print(json.load(sys.stdin).get('profileArn','NOT FOUND'))"
#
# Or if using kiro-cli (SQLite):
#   sqlite3 ~/.local/share/kiro-cli/data.sqlite3 "SELECT value FROM state WHERE key='api.codewhisperer.profile';"
#
# Format: arn:aws:codewhisperer:<region>:<account-id>:profile/<profile-id>

# ===========================================
# AUTHENTICATION OPTIONS
# ===========================================

# Option 1: Kiro IDE credentials file (recommended, used above)
# KIRO_CREDS_FILE="~/.aws/sso/cache/kiro-auth-token.json"

# Option 1b: Inline JSON (cloud deployments without file mounts)
# KIRO_CREDS_JSON='{"refreshToken":"...","accessToken":"...","profileArn":"..."}'

# Option 2: Refresh token directly
# REFRESH_TOKEN="your_kiro_refresh_token_here"

# Option 3: kiro-cli SQLite database (AWS SSO / Builder ID)
# KIRO_CLI_DB_FILE="~/.local/share/kiro-cli/data.sqlite3"

# Option 4: AWS SSO cache file
# KIRO_CREDS_FILE="~/.aws/sso/cache/your-sso-cache-file.json"

# ===========================================
# REGION
# ===========================================

# KIRO_API_REGION="us-east-1"
# KIRO_REGION="us-east-1"

# ===========================================
# SERVER
# ===========================================

# SERVER_HOST="0.0.0.0"
# SERVER_PORT="8000"

# ===========================================
# VPN/PROXY
# ===========================================

# VPN_PROXY_URL="http://127.0.0.1:7890"
# VPN_PROXY_URL="socks5://127.0.0.1:1080"

# ===========================================
# MULTI-ACCOUNT
# ===========================================

# ACCOUNT_SYSTEM=false
# ACCOUNTS_CONFIG_FILE="credentials.json"
# ACCOUNTS_STATE_FILE="state.json"
# ACCOUNT_RECOVERY_TIMEOUT=60
# ACCOUNT_MAX_BACKOFF_MULTIPLIER=1440.0
# ACCOUNT_PROBABILISTIC_RETRY_CHANCE=0.1
# ACCOUNT_CACHE_TTL=43200
# STATE_SAVE_INTERVAL_SECONDS=10

# ===========================================
# STREAMING & TIMEOUTS
# ===========================================

# FIRST_TOKEN_TIMEOUT="15"
# FIRST_TOKEN_MAX_RETRIES="3"
# STREAMING_READ_TIMEOUT="300"

# ===========================================
# FAKE REASONING (Extended Thinking)
# ===========================================

# FAKE_REASONING=true
# FAKE_REASONING_MAX_TOKENS=4000
# FAKE_REASONING_BUDGET_CAP=10000
# FAKE_REASONING_HANDLING=as_reasoning_content
# FAKE_REASONING_INITIAL_BUFFER_SIZE=20

# ===========================================
# FEATURES
# ===========================================

# WEB_SEARCH_ENABLED=true
# AUTO_TRIM_PAYLOAD=false
# KIRO_MAX_PAYLOAD_BYTES=600000
# TRUNCATION_RECOVERY=true
# SQLITE_READONLY=false

# ===========================================
# LOGGING & DEBUG
# ===========================================

# LOG_LEVEL="INFO"
# DEBUG_MODE=off
# DEBUG_DIR="debug_logs"
